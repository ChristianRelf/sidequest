# Copy to .env; generate a unique database password before deployment.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://sidequest:replace-with-a-long-random-password@localhost:5432/sidequest
APP_URL=http://localhost:3000
COOKIE_SECURE=false
# Never enable on an internet-facing installation unless public signup is intended.
ALLOW_SIGNUP=true
# Optional AI: off (default), ollama, or compatible. Only the administrator sets endpoints.
AI_PROVIDER=off
AI_BASE_URL=http://host.docker.internal:11434
AI_MODEL=llama3.2
AI_API_KEY=
# Optional email reminder adapter (in-app always available).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sidequest <sidequest@example.com>
# Local evaluation only; no default production credentials.
DEMO_EMAIL=
DEMO_PASSWORD=
